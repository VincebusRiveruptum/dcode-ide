# Compile with Watcom 10.6 or OpenWatcom
CC = wcc386
APPNAME = TUI

CFLAGS = -dTUI_STANDALONE -i..\INPUT /4r /s /otexan
OBJDIR = .

# Object files in BIN
OBJS = $(OBJDIR)\$(APPNAME).OBJ $(OBJDIR)\INPUT.OBJ $(OBJDIR)\VGAREGS.OBJ $(OBJDIR)\DATA.OBJ $(OBJDIR)\SORT.OBJ $(OBJDIR)\DRAW.OBJ $(OBJDIR)\EL.OBJ $(OBJDIR)\TEST.OBJ
# Linker directive file
LNK = $(OBJDIR)\$(APPNAME).lnk
    # Final executable
$(APPNAME).EXE: $(OBJS)
        @%create $(LNK)
        @%append $(LNK) system dos4g
        @%append $(LNK) name $(APPNAME).EXE
        @for %i in ($(OBJS)) do @%append $(LNK) file %i

        #IF USES 32 BIT DOS INCLUDES
        @%append $(LNK) library clib3r.lib
        wlink @$(LNK)
# Compile rules for each .c -> .obj in BIN
# External DEPS
$(OBJDIR)\INPUT.OBJ: ..\INPUT\INPUT.C
    if not exist $(OBJDIR) mkdir $(OBJDIR)
    $(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\VGAREGS.OBJ: ..\VGA\VGAREGS.C
    if not exist $(OBJDIR) mkdir $(OBJDIR)
    $(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\DATA.OBJ: ..\DATA\DATA.C
    if not exist $(OBJDIR) mkdir $(OBJDIR)
    $(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\SORT.OBJ: ..\SORT\SORT.C
    if not exist $(OBJDIR) mkdir $(OBJDIR)
    $(CC) $(CFLAGS) -fo=$@ $<

# Main
$(OBJDIR)\TEST.OBJ: TEST.C
    if not exist $(OBJDIR) mkdir $(OBJDIR)
    $(CC) $(CFLAGS) -fo=$@ $<
$(OBJDIR)\DRAW.OBJ: DRAW.C
    if not exist $(OBJDIR) mkdir $(OBJDIR)
    $(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\EL.OBJ: EL.C
    if not exist $(OBJDIR) mkdir $(OBJDIR)
    $(CC) $(CFLAGS) -fo=$@ $<

$(OBJDIR)\$(APPNAME).OBJ: $(APPNAME).C
    if not exist $(OBJDIR) mkdir $(OBJDIR)
    $(CC) $(CFLAGS) -fo=$@ $<


preclean: .SYMBOLIC
    del *.obj
    del *.exe
    del *.err
    del *.lnk

postclean: .SYMBOLIC
    del *.obj
    del *.lnk

build: preclean $(APPNAME).EXE postclean
